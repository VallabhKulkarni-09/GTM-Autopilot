# GTM Autopilot — Environment Variables
# Copy this to .env and fill in all values before running locally or deploying.

# ─── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here   # Settings → API → service_role

# ─── Redis (Railway Redis service) ───────────────────────────────────────────
REDIS_URL=redis://default:password@host:6379

# ─── HubSpot ──────────────────────────────────────────────────────────────────
# Settings → Integrations → Private Apps → Create app
# Scopes: crm.objects.contacts.read, crm.objects.contacts.write
HUBSPOT_API_KEY=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Settings → Integrations → Webhooks → Your webhook → Signing secret
HUBSPOT_WEBHOOK_SECRET=your-webhook-signing-secret

# ─── Salesforce (use sandbox for testing) ─────────────────────────────────────
# Setup → App Manager → New Connected App
# Enable OAuth, callback URL: https://login.salesforce.com/services/oauth2/callback
# Scopes: api, refresh_token, offline_access
SF_CLIENT_ID=your-connected-app-consumer-key
SF_CLIENT_SECRET=your-connected-app-consumer-secret
SF_INSTANCE_URL=https://your-sandbox.my.salesforce.com
SF_REFRESH_TOKEN=your-oauth-refresh-token  # Get this after the OAuth flow

# ─── Outreach ─────────────────────────────────────────────────────────────────
# Settings → API → Create OAuth App
OUTREACH_API_KEY=your-outreach-api-key
OUTREACH_CLIENT_ID=your-outreach-client-id
OUTREACH_CLIENT_SECRET=your-outreach-client-secret

# ─── Clearbit ─────────────────────────────────────────────────────────────────
# dashboard.clearbit.com → API keys
CLEARBIT_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-64-char-hex-secret-here

# ─── App ──────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
DEFAULT_ORG_ID=your-supabase-org-uuid-here  # From organizations table

# ─── Slack (for SLA breach escalation) ───────────────────────────────────────
# api.slack.com/apps → Create app → Incoming Webhooks → Activate → Add to workspace
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../xxxx
