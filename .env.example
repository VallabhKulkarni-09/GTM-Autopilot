# GTM Autopilot — Environment Variable Reference
# This file is safe to commit. Never commit .env itself.
# Copy to .env and fill in real values.

# ─── Database ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# ─── GitHub ───────────────────────────────────────────────────────────────────
GITHUB_TOKEN=<your-github-pat-here>
GITHUB_REPO=your-org/gtm-autopilot

# ─── Railway ──────────────────────────────────────────────────────────────────
RAILWAY_TOKEN=your-railway-token

# ─── Salesforce ───────────────────────────────────────────────────────────────
SF_INSTANCE_URL=https://your-instance.salesforce.com
SF_CLIENT_ID=your-connected-app-client-id
SF_CLIENT_SECRET=your-connected-app-client-secret
SF_SANDBOX=true

# ─── HubSpot ──────────────────────────────────────────────────────────────────
HUBSPOT_API_KEY=your-hubspot-private-app-token
HUBSPOT_WEBHOOK_SECRET=your-webhook-secret

# ─── Outreach ─────────────────────────────────────────────────────────────────
OUTREACH_API_KEY=your-outreach-api-key

# ─── Clearbit ─────────────────────────────────────────────────────────────────
CLEARBIT_API_KEY=your-clearbit-api-key

# ─── Queue ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Slack (escalation notifications) ────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../xxx

# ─── App ──────────────────────────────────────────────────────────────────────
JWT_SECRET=a-long-random-secret-at-least-32-chars
NODE_ENV=development
